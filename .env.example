# Copy to .env.local for local development and set the same variables in Vercel
# (Project → Settings → Environment Variables). Never commit real values.

# Google Sheet — Apps Script web app (integrations/apps-script/Code.gs)
SHEETS_WEBHOOK_URL=
SHEETS_WEBHOOK_SECRET=

# HubSpot service key (or legacy private-app token) (scopes: crm.objects.contacts.read, crm.objects.contacts.write)
HUBSPOT_TOKEN=

# Email notification — Gmail SMTP with an app password
GMAIL_USER=
GMAIL_APP_PASSWORD=
# Optional; defaults to ai-labs@hexanovate.com
LEAD_NOTIFY_TO=

# Optional; extra origins allowed to POST /api/lead (comma-separated). The site's own origin is always allowed.
ALLOWED_ORIGINS=
